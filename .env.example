# Jitsi configuration (client-side via Vite)
# Copy this file to `.env.local` and fill in values as needed.

# API base URL (Laravel backend)
VITE_API_BASE_URL=http://localhost:8000

# Where to load the Jitsi external API script from
VITE_JITSI_EXTERNAL_API_URL=https://meet.jit.si/external_api.js

# Jitsi domain (server hosting the conference)
VITE_JITSI_DOMAIN=meet.ffmuc.net

# Optional: JWT for authenticated conferences
# WARNING: Do NOT commit real tokens; client-side envs are public at build time.
VITE_JITSI_JWT=